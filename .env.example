# Copy this file to .env and fill in real values. Never commit .env.
# With the Neon CLI, `neon env pull` writes the DATABASE_URL* values for you.

# Runtime environment: development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL. Paste URLs exactly as Neon gives them (postgresql://...?sslmode=require);
# app/core/config.py converts them to the asyncpg format.
# DATABASE_URL is Neon's pooled (PgBouncer) URL; the app prefers the direct one below.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Signs access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (The placeholder below is deliberately too short, so the app refuses to start until you replace it.)
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth client: Google Auth Platform > Clients > Web application.
# Redirect URI registered there: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback  (default)

# Where the browser lands after Google sign-in (the web app's origin).
# WEB_APP_URL=http://localhost:5173  (default)

# LLM access through OpenRouter (https://openrouter.ai/keys). Set a credit limit on the key.
OPENROUTER_API_KEY=
# Any OpenRouter model slug; switching models is a config change.
LLM_MODEL=anthropic/claude-opus-5.5
# openrouter | fake (fake = no key, no network; used by tests)
LLM_PROVIDER=openrouter

# Separate database/branch used by pytest; must never point at real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
